<Window x:Class="StealYourVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StealYourVoice.Controls"
        Title="Steal Your Voice"
        Icon="Assets/app.ico"
        Width="1040" Height="810"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial Black" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial Black" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#E60012" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#EE0A0A0A" />
            <Setter Property="BorderBrush" Value="#F5F5F5" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Padding" Value="22,14,22,16" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <c:ShardBackground />

        <Grid x:Name="Stage" Margin="28,14,28,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <c:SlashToggle x:Name="UpdateBtn" Text="ОБНОВЛЕНИЕ" IsToggle="True" FontSize="13" Tilt="-2"
                                   Visibility="Collapsed" Hint="Вышла новая версия — нажми, чтобы обновиться и перезапуститься" />
                    <c:SlashToggle x:Name="MinBtn" Text="—" IsToggle="False" Width="58" Hint="Свернуть в трей" />
                    <c:SlashToggle x:Name="CloseBtn" Text="✕" IsToggle="False" Sound="cancel" Width="58" Hint="Выход" />
                </StackPanel>
                <c:RansomTitle x:Name="TitleText" Text="STEAL YOUR VOICE" Seed="7" LetterSize="34" HorizontalAlignment="Left" />
            </DockPanel>

            <!-- Status tag + tools -->
            <DockPanel Grid.Row="1" Margin="0,10,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <c:SlashToggle x:Name="CalibBtn" Text="АВТОНАСТРОЙКА" IsToggle="False" Sound="" FontSize="13" Height="34" Tilt="-1.5"
                                   Hint="3 секунды тишины + 5 секунд голоса — и программа сама выставит громкость, шумодав и компрессор" />
                    <c:SlashToggle x:Name="DiagBtn" Text="ДИАГНОСТИКА" IsToggle="False" Sound="" FontSize="13" Height="34" Tilt="1"
                                   Hint="Найти типичные проблемы со звуком и микрофоном" />
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#F5F5F5" Padding="14,3,18,3" Margin="6,0,0,6">
                    <Border.RenderTransform>
                        <SkewTransform AngleX="-18" />
                    </Border.RenderTransform>
                    <TextBlock x:Name="StatusText" Text="ПОИСК VOICEMEETER..." FontFamily="Arial Black" FontSize="13" Foreground="#0A0A0A" />
                </Border>
            </DockPanel>

            <!-- Main cards -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- MIC CARD -->
                <Border x:Name="MicCard" Grid.Column="0" Style="{StaticResource Card}">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-1" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="МИКРОФОН" />

                        <WrapPanel x:Name="StripPanel" Margin="0,4,0,0" />

                        <c:SlashToggle x:Name="DeviceBtn" IsToggle="False" Text="УСТРОЙСТВО: —" FontSize="12"
                                       HorizontalAlignment="Left" Hint="Выбрать, какое устройство сидит на этом входе" />
                        <c:SlashToggle x:Name="HeadBtn" IsToggle="False" Text="НАУШНИКИ (A1): —" FontSize="12"
                                       HorizontalAlignment="Left" Tilt="-0.7"
                                       Hint="Куда Voicemeeter выводит звук шины A1 — сюда приходит «слышать себя»" />

                        <c:JaggedMeter x:Name="MicMeter" Margin="0,4,0,10" />

                        <WrapPanel>
                            <c:SlashToggle x:Name="MonoT" Text="MONO" Hint="Голос в оба канала (лечит «только левое ухо»)" />
                            <c:SlashToggle x:Name="MuteT" Text="MUTE" Tilt="-2" Hint="Выключить микрофон" />
                            <c:SlashToggle x:Name="A1T" Text="СЛЫШАТЬ СЕБЯ" Hint="Шина A1 — голос в наушники" />
                            <c:SlashToggle x:Name="B1T" Text="В ЗАПИСЬ" Tilt="1.5" Hint="Шина B1 — голос уходит в ShadowPlay / Discord" />
                        </WrapPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <c:SlashSlider x:Name="GainS" Grid.Row="0" Grid.Column="0" Label="ГРОМКОСТЬ"
                                           Minimum="-60" Maximum="12" Default="0" Step="0.5" Unit=" dB"
                                           Hint="Громкость микрофона. Двойной клик — 0 dB" />
                            <c:SlashSlider x:Name="GateS" Grid.Row="0" Grid.Column="2" Label="ШУМОДАВ"
                                           Minimum="0" Maximum="10" Default="0" Step="0.5"
                                           Hint="Gate: глушит фон в паузах. Начни с 3–4" />
                            <c:SlashSlider x:Name="CompS" Grid.Row="2" Grid.Column="0" Label="КОМПРЕССОР"
                                           Minimum="0" Maximum="10" Default="0" Step="0.5"
                                           Hint="Выравнивает громкость: тихое громче, крик тише. 4–5 — норм" />
                            <c:SlashSlider x:Name="ToneS" Grid.Row="2" Grid.Column="2" Label="ТЕМБР"
                                           Minimum="-5" Maximum="5" Default="0" Step="0.5"
                                           Bipolar="True" Hint="Влево — теплее, вправо — ярче и разборчивее" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OUTPUT CARD -->
                <Border x:Name="OutCard" Grid.Column="2" Style="{StaticResource Card}">
                    <Border.RenderTransform>
                        <RotateTransform Angle="1" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="ЗАПИСЬ // B1" />
                        <TextBlock Text="То, что слышат ShadowPlay и Discord" Foreground="#808080" FontSize="12" Margin="2,0,0,8" />

                        <c:JaggedMeter x:Name="OutMeter" Margin="0,0,0,10" />
                        <c:SlashSlider x:Name="OutGainS" Label="ГРОМКОСТЬ B1" Minimum="-60" Maximum="12" Default="0"
                                       Step="0.5" Unit=" dB" Hint="Общая громкость того, что уходит в запись" />
                        <WrapPanel Margin="0,10,0,0">
                            <c:SlashToggle x:Name="OutMuteT" Text="MUTE B1" Hint="Заглушить весь выход в запись" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource SubHeader}" Text="ПРЕСЕТЫ" />
                        <WrapPanel x:Name="PresetPanel" />
                        <TextBlock Text="ПКМ по своему пресету — перезаписать / удалить" Foreground="#808080" FontSize="11" Margin="2,0,0,0" />

                        <DockPanel Margin="0,10,0,6">
                            <TextBlock x:Name="DuckState" DockPanel.Dock="Right" Text="ВЫКЛЮЧЕНО" Foreground="#808080"
                                       FontFamily="Arial Black" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,4,3" />
                            <TextBlock Style="{StaticResource SubHeader}" Text="АВТОПРИГЛУШЕНИЕ" Margin="0" />
                        </DockPanel>
                        <WrapPanel>
                            <c:SlashToggle x:Name="DuckT" Text="ВКЛ" FontSize="13" Height="32" Tilt="-1"
                                           Hint="Когда говоришь, игра/музыка в Voicemeeter стихает. Звук игры должен идти в Voicemeeter Input" />
                            <c:SlashToggle x:Name="DuckMainT" Text="VM INPUT" FontSize="13" Height="32"
                                           Hint="Приглушать виртуальный вход «Voicemeeter Input» (обычно туда идёт весь звук Windows / игра)" />
                            <c:SlashToggle x:Name="DuckAuxT" Text="AUX" FontSize="13" Height="32" Tilt="1"
                                           Hint="Приглушать виртуальный вход «Voicemeeter AUX» (например, музыка или Discord)" />
                            <c:SlashToggle x:Name="GameToB1T" Text="ИГРУ В ЗАПИСЬ" FontSize="13" Height="32"
                                           Hint="Отправлять Voicemeeter Input ещё и в B1 — тогда в клипе ShadowPlay будет игра уже с приглушением. В ShadowPlay поставь «Системные звуки» на 0%" />
                        </WrapPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:SlashSlider x:Name="DuckAmountS" Grid.Column="0" Label="НА СКОЛЬКО" Minimum="-30" Maximum="-2"
                                           Default="-12" Step="1" Unit=" dB" Decimals="0"
                                           Hint="Насколько тише становится игра, пока ты говоришь" />
                            <c:SlashSlider x:Name="DuckThreshS" Grid.Column="2" Label="ПОРОГ ГОЛОСА" Minimum="-60" Maximum="-15"
                                           Default="-40" Step="1" Unit=" dB" Decimals="0"
                                           Hint="Громкость микрофона, с которой считается, что ты говоришь. Срабатывает от шума — подними; не срабатывает — опусти" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Grid.Row="3" Margin="4,12,0,0">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="#9A9A9A" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,8" />
                <WrapPanel>
                    <c:SlashToggle x:Name="HotkeyBtn" IsToggle="False" Text="MUTE НА КЛАВИШЕ: PAUSE" FontSize="12" Height="32"
                                   Hint="Глобальная горячая клавиша вкл/выкл микрофона. Нажми и введи комбинацию. Backspace — убрать, Esc — отмена" />
                    <c:SlashToggle x:Name="ToastT" Text="ПЛАШКА MIC OFF" FontSize="12" Height="32" Tilt="1"
                                   Hint="Показывать «MIC OFF / MIC ON» поверх экрана при переключении" />
                    <c:SlashToggle x:Name="ShowVmBtn" Text="VOICEMEETER" IsToggle="False" FontSize="12" Height="32"
                                   Hint="Открыть окно Voicemeeter" />
                    <c:SlashToggle x:Name="RestartBtn" Text="РЕСТАРТ ЗВУКА" IsToggle="False" FontSize="12" Height="32" Tilt="-1"
                                   Hint="Restart Audio Engine — если звук заикается или пропал" />
                    <c:SlashToggle x:Name="SfxT" Text="ЗВУКИ" FontSize="12" Height="32" Tilt="1.5"
                                   Hint="Звуки интерфейса. Свои .wav (hover, click, confirm, cancel, whoosh) можно положить в папку звуков — см. меню иконки в трее" />
                    <c:SlashToggle x:Name="AutostartT" Text="АВТОЗАПУСК" FontSize="12" Height="32" Tilt="-1"
                                   Hint="Запускаться вместе с Windows (сразу в трей)" />
                </WrapPanel>
            </DockPanel>
        </Grid>

        <!-- Calibration / diagnostics overlay -->
        <Grid x:Name="ToolOverlay" Background="#E80A0A0A" Visibility="Collapsed">
            <Border Background="#0A0A0A" BorderBrush="#F5F5F5" BorderThickness="3" Padding="28,18,28,20" Width="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-1" />
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="ToolTitle" Style="{StaticResource Header}" Text="АВТОНАСТРОЙКА" />
                    <TextBlock x:Name="ToolStep" Foreground="#E60012" FontFamily="Arial Black" FontStyle="Italic" FontSize="26"
                               Margin="0,4,0,4" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToolSub" Foreground="#B0B0B0" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,10" />
                    <c:JaggedMeter x:Name="ToolMeter" Margin="0,0,0,12" />
                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ToolBody" />
                    </ScrollViewer>
                    <WrapPanel x:Name="ToolButtons" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Save preset overlay -->
        <Grid x:Name="SaveOverlay" Background="#E00A0A0A" Visibility="Collapsed">
            <Border Background="#0A0A0A" BorderBrush="#F5F5F5" BorderThickness="3" Padding="28,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-1.5" />
                </Border.RenderTransform>
                <StackPanel Width="420">
                    <TextBlock Style="{StaticResource Header}" Text="НОВЫЙ ПРЕСЕТ" />
                    <TextBlock Text="Сохранит текущие настройки микрофона и громкость B1" Foreground="#9A9A9A" FontSize="12" Margin="2,0,0,12" />
                    <TextBox x:Name="PresetNameBox" MaxLength="16" FontFamily="Arial Black" FontSize="20"
                             Background="#1A1A1A" Foreground="#F5F5F5" CaretBrush="#F5F5F5" SelectionBrush="#E60012"
                             BorderBrush="#E60012" BorderThickness="3" Padding="10,6" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <c:SlashToggle x:Name="SaveOk" Text="СОХРАНИТЬ" IsToggle="False" Sound="confirm" Height="40" FontSize="16" />
                        <c:SlashToggle x:Name="SaveCancel" Text="ОТМЕНА" IsToggle="False" Sound="cancel" Height="40" FontSize="16" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Offline overlay -->
        <Grid x:Name="Offline" Background="#F00A0A0A" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <c:RansomTitle Text="NO SIGNAL" Seed="3" LetterSize="48" HorizontalAlignment="Center" />
                <TextBlock x:Name="OfflineText" Text="Ищу Voicemeeter..." Foreground="#F5F5F5" FontFamily="Arial Black"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,26,0,18" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <c:SlashToggle x:Name="LaunchBtn" Text="ЗАПУСТИТЬ VOICEMEETER" IsToggle="False" Sound="confirm" Height="44" FontSize="17" />
                    <c:SlashToggle x:Name="OfflineCloseBtn" Text="ВЫХОД" IsToggle="False" Sound="cancel" Height="44" FontSize="17" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- transition layer -->
        <c:SlashWipe x:Name="Wipe" />
    </Grid>
</Window>
